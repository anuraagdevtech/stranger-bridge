# --- Postgres (used by apps/server via Prisma) ---
# Local docker-compose default. Swap for a hosted free Postgres (Neon/Supabase)
# if you don't want to run Docker locally.
DATABASE_URL="postgresql://stranger_bridge:stranger_bridge@localhost:5432/stranger_bridge?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# --- Web (apps/web/.env.local should mirror these) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# --- Mobile (apps/mobile/.env should mirror these, reachable from a device/simulator) ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_SOCKET_URL="http://localhost:4000"
